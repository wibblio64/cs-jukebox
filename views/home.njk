{% extends "layout.njk" %}

{% block metadata %}
    <title>Moonsong</title>
{% endblock %}

{% block content %}
    <div class="moon"></div>
    <div class="cloud4"></div>
    <div class="cloud3"></div>
    <div class="cloud2"></div>
    <div class="cloud1"></div>
    <div class="dragon">
        <div class="dragon-inner"></div>
    </div>
    <div class="tracklist">
        <div id="track-toggle" onclick="toggleTrack();"></div>
        <div id="current-track"></div>
        <div class="tracklist-inner">
            {% for track in data[s].tracks %}
            <div class="track" onclick="startTrack(`/music/{{ s }}/{{ track }}.mp3`, `{{ track }}`);">
                <span class="track-number">{{ loop.index }}.</span>
                {{ track }}
            </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}