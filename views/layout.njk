<!DOCTYPE html>
<html lang="en">
    <head>
        <!-- stylesheets -->
        <link rel="icon" type="image/png" href="/images/favicon.png">
        <link rel="stylesheet" href="/css/fonts.css"/>
        <link rel="stylesheet" href="/css/themes.css"/>
        <link rel="stylesheet" href="/css/styles.css"/>
        <link rel="stylesheet" href="/css/not-found.css"/>
        <link rel="stylesheet" href="/css/menu.css"/>
        <link rel="stylesheet" href="/css/radio.css"/>

        <!-- scripts -->
        <script src="/js/lib/howler.min.js"></script>
        <script src="/js/sounds.js"></script>
        <script src="/js/themes.js"></script>
        <script src="/js/radio.js"></script>

        <!-- metadata -->
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta property="og:site_name" content="CS Jukebox"/>
        {% block metadata %}{% endblock %}
    </head>
    <body>
        <div id="root">
            <div class="moon"></div>
            <div class="cloud4"></div>
            <div class="cloud3"></div>
            <div class="cloud2"></div>
            <div class="cloud1"></div>
            <div class="dragon">
                <a href="/">
                    <div class="dragon-inner"></div>
                </a>
            </div>
            <footer class="footer">
                <div style="margin-left: 16px;">Created by <a target="_blank" rel="noopener noreferrer" href="https://wibblio.neocities.org/">wibblio</a></div>
                <div style="margin-right: 16px;">View on <a target="_blank" rel="noopener noreferrer" href="https://github.com/wibblio64/cs-jukebox">GitHub</a></div>
            </footer>
            {% block content %}{% endblock %}
        </div>
    </body>
</html>